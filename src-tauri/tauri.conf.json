{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "走马灯行情",
  "version": "0.1.0",
  "identifier": "com.zoumadeng.ticker",
  "build": {
    "beforeDevCommand": "node scripts/start-vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "走马灯行情",
        "width": 1120,
        "height": 66,
        "minWidth": 1,
        "minHeight": 46,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://qt.gtimg.cn https://smartbox.gtimg.cn; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "startMenuFolder": "走马灯行情"
      }
    }
  }
}
